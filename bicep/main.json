{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "13236299276639168265"
    }
  },
  "parameters": {
    "environment": {
      "type": "string",
      "allowedValues": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "prefix": {
      "type": "string",
      "defaultValue": "iislab",
      "minLength": 3,
      "maxLength": 10
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "appServiceSku": {
      "type": "string",
      "defaultValue": "B1"
    },
    "publisherName": {
      "type": "string",
      "defaultValue": "iis-release-lab"
    },
    "publisherEmail": {
      "type": "string",
      "defaultValue": "owner@example.com"
    },
    "allowedIps": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Public IPs allowed to reach the storage account. Everything else is denied."
      }
    }
  },
  "variables": {
    "name": "[format('{0}-{1}', parameters('prefix'), parameters('environment'))]",
    "busName": "[format('sb-{0}', variables('name'))]",
    "tags": {
      "environment": "[parameters('environment')]",
      "managed_by": "bicep"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[format('st{0}', uniqueString(resourceGroup().id))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "networkAcls": {
          "copy": [
            {
              "name": "ipRules",
              "count": "[length(parameters('allowedIps'))]",
              "input": {
                "value": "[parameters('allowedIps')[copyIndex('ipRules')]]",
                "action": "Allow"
              }
            }
          ],
          "defaultAction": "Deny",
          "bypass": "AzureServices, Logging, Metrics"
        }
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('log-{0}', variables('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('appi-{0}', variables('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', variables('name')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', variables('name')))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('plan-{0}', variables('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "[parameters('appServiceSku')]"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[format('app-{0}', variables('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "app",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('plan-{0}', variables('name')))]",
        "httpsOnly": true,
        "siteConfig": {
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "alwaysOn": true,
          "healthCheckPath": "/health.html",
          "appSettings": [
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', format('appi-{0}', variables('name'))), '2020-02-02').ConnectionString]"
            },
            {
              "name": "ServiceBusNamespace",
              "value": "[format('{0}.servicebus.windows.net', variables('busName'))]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', format('appi-{0}', variables('name')))]",
        "[resourceId('Microsoft.Web/serverfarms', format('plan-{0}', variables('name')))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[format('func-{0}', variables('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "functionapp",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('plan-{0}', variables('name')))]",
        "httpsOnly": true,
        "siteConfig": {
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "appSettings": [
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[format('st{0}', uniqueString(resourceGroup().id))]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "dotnet-isolated"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', format('plan-{0}', variables('name')))]",
        "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}', uniqueString(resourceGroup().id)))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service",
      "apiVersion": "2022-08-01",
      "name": "[format('apim-{0}', variables('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Consumption",
        "capacity": 0
      },
      "properties": {
        "publisherName": "[parameters('publisherName')]",
        "publisherEmail": "[parameters('publisherEmail')]"
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "servicebus",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[variables('busName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          },
          "senderPrincipalId": {
            "value": "[reference(resourceId('Microsoft.Web/sites', format('app-{0}', variables('name'))), '2023-12-01', 'full').identity.principalId]"
          },
          "receiverPrincipalId": {
            "value": "[reference(resourceId('Microsoft.Web/sites', format('func-{0}', variables('name'))), '2023-12-01', 'full').identity.principalId]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.49.2.45890",
              "templateHash": "4778684818446830371"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Namespace name."
              }
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object",
              "defaultValue": {}
            },
            "senderPrincipalId": {
              "type": "string",
              "metadata": {
                "description": "Principal that may send messages (the web app identity)."
              }
            },
            "receiverPrincipalId": {
              "type": "string",
              "metadata": {
                "description": "Principal that may receive messages (the function identity)."
              }
            }
          },
          "variables": {
            "senderRole": "69a216fc-b8fb-44d8-bc22-1f3c2cd27a39",
            "receiverRole": "4f6d3b9b-027b-4f4c-9142-0e5a2a2247e0"
          },
          "resources": [
            {
              "type": "Microsoft.ServiceBus/namespaces",
              "apiVersion": "2022-10-01-preview",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "Standard",
                "tier": "Standard"
              },
              "properties": {
                "minimumTlsVersion": "1.2"
              }
            },
            {
              "type": "Microsoft.ServiceBus/namespaces/queues",
              "apiVersion": "2022-10-01-preview",
              "name": "[format('{0}/{1}', parameters('name'), 'orders')]",
              "properties": {
                "maxDeliveryCount": 5,
                "deadLetteringOnMessageExpiration": true
              },
              "dependsOn": [
                "[resourceId('Microsoft.ServiceBus/namespaces', parameters('name'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.ServiceBus/namespaces', parameters('name'))]",
              "name": "[guid(resourceId('Microsoft.ServiceBus/namespaces', parameters('name')), parameters('senderPrincipalId'), variables('senderRole'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('senderRole'))]",
                "principalId": "[parameters('senderPrincipalId')]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ServiceBus/namespaces', parameters('name'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.ServiceBus/namespaces', parameters('name'))]",
              "name": "[guid(resourceId('Microsoft.ServiceBus/namespaces', parameters('name')), parameters('receiverPrincipalId'), variables('receiverRole'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('receiverRole'))]",
                "principalId": "[parameters('receiverPrincipalId')]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ServiceBus/namespaces', parameters('name'))]"
              ]
            }
          ],
          "outputs": {
            "namespaceHost": {
              "type": "string",
              "value": "[format('{0}.servicebus.windows.net', parameters('name'))]"
            },
            "queueName": {
              "type": "string",
              "value": "orders"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', format('func-{0}', variables('name')))]",
        "[resourceId('Microsoft.Web/sites', format('app-{0}', variables('name')))]"
      ]
    }
  ],
  "outputs": {
    "webAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', format('app-{0}', variables('name'))), '2023-12-01').defaultHostName)]"
    },
    "queue": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'servicebus'), '2025-04-01').outputs.queueName.value]"
    }
  }
}